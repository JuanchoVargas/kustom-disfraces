# Origen del catálogo del frontend: local (catalogo.json) | woo (proxy a WooCommerce).
# Default local — cambiar a woo SOLO tras verificar paridad (ver README, Fase D).
DATA_SOURCE=local

# Credenciales de WooCommerce (backend headless en api.*)
# Copiar a .env y llenar con las llaves reales (WooCommerce → Ajustes → Avanzado → REST API)
WOO_API_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
