# Origen del catálogo del frontend: local (catalogo.json) | woo (proxy a WooCommerce).
# Default local — cambiar a woo SOLO tras verificar paridad (ver README, Fase D).
DATA_SOURCE=local

# Credenciales de WooCommerce (backend headless en api.*)
# Copiar a .env y llenar con las llaves reales (WooCommerce → Ajustes → Avanzado → REST API)
# Esta llave es de solo LECTURA (catálogo).
WOO_API_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Llave de WooCommerce con permiso de ESCRITURA (Lectura/Escritura) — Fase 3.
# Solo la usa el webhook para CREAR órdenes al aprobarse un pago. Misma tienda
# (WOO_API_URL). Sin ella, el pago se registra en el log pero no se crea orden.
WOO_ORDERS_CONSUMER_KEY=
WOO_ORDERS_CONSUMER_SECRET=

# SMTP para el formulario de mayoristas (/api/mayoristas → contacto@disfraceskustom.com)
# Buzón Hostinger ya creado (contacto@). Sin estos valores, el formulario responde
# 503 y el front muestra el correo directo como fallback.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@disfraceskustom.com
SMTP_PASS=
SMTP_FROM=contacto@disfraceskustom.com
MAYORISTAS_TO=contacto@disfraceskustom.com
# Buzon de VENTAS: adonde llega el aviso de cada pago aprobado (correo de confirmacion).
# Debe existir en Hostinger y NO leerse desde la misma cuenta Gmail que contacto@.
VENTAS_TO=ventas@disfraceskustom.com

# Mercado Pago — Fase 1: credenciales de PRUEBA (sandbox), NO producción.
# MP → Tus integraciones → tu app → Credenciales de prueba.
# Sin MP_ACCESS_TOKEN, /api/checkout/mercadopago responde 503 y queda WhatsApp.
MP_ACCESS_TOKEN=        # SECRETO, solo servidor. En Fase 1 empieza por "TEST-"
MP_PUBLIC_KEY=          # Público (frontend). En Fase 1 empieza por "TEST-"
# Firma del webhook (Fase 2, opcional pero recomendado). Se copia de MP → Webhooks
# → "Clave secreta". Si está, /api/webhooks/mercadopago valida x-signature.
MP_WEBHOOK_SECRET=

# Bot de WhatsApp (Cloud API de Meta) — server/api/whatsapp. Prefijo NUXT_ para
# que funcionen como override en RUNTIME (Vercel). Sin token/phone_id, el bot
# calcula la respuesta pero no la envia (se registra en el log).
NUXT_WHATSAPP_TOKEN=          # Token de la app de Meta (WhatsApp → API Setup)
NUXT_WHATSAPP_PHONE_ID=       # Phone number ID del numero de prueba/produccion
NUXT_WHATSAPP_VERIFY_TOKEN=   # Cadena que TU inventas; la misma va en Meta → Webhook
# Kill-switch temporal: 'true' fuerza TODOS los menus a texto numerado (no intenta
# interactivo). Util mientras Meta acepta y descarta el interactivo. Vacio/otro = off.
NUXT_WHATSAPP_FORCE_TEXT_MENU=

# Precio tachado (gancho de oferta) — SOLO visual, no toca el precio real cobrado
# ni la validacion server-side. Apagado por defecto; se activa sin redeploy.
NUXT_PUBLIC_SHOW_DISCOUNT=false
NUXT_PUBLIC_FAKE_DISCOUNT_PCT=30
