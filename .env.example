# Origen del catálogo del frontend: local (catalogo.json) | woo (proxy a WooCommerce).
# Default local — cambiar a woo SOLO tras verificar paridad (ver README, Fase D).
DATA_SOURCE=local

# Credenciales de WooCommerce (backend headless en api.*)
# Copiar a .env y llenar con las llaves reales (WooCommerce → Ajustes → Avanzado → REST API)
# Esta llave es de solo LECTURA (catálogo).
WOO_API_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Llave de WooCommerce con permiso de ESCRITURA (Lectura/Escritura) — Fase 3.
# Solo la usa el webhook para CREAR órdenes al aprobarse un pago. Misma tienda
# (WOO_API_URL). Sin ella, el pago se registra en el log pero no se crea orden.
WOO_WRITE_CONSUMER_KEY=
WOO_WRITE_CONSUMER_SECRET=
# Nombre ANTERIOR de la misma llave (respaldo, se retirará): WOO_ORDERS_CONSUMER_KEY / _SECRET

# SMTP para el formulario de mayoristas (/api/mayoristas → contacto@disfraceskustom.com)
# Buzón Hostinger ya creado (contacto@). Sin estos valores, el formulario responde
# 503 y el front muestra el correo directo como fallback.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@disfraceskustom.com
SMTP_PASS=
SMTP_FROM=contacto@disfraceskustom.com
MAYORISTAS_TO=contacto@disfraceskustom.com
# Buzon de VENTAS: adonde llega el aviso de cada pago aprobado (correo de confirmacion).
# Debe existir en Hostinger y NO leerse desde la misma cuenta Gmail que contacto@.
VENTAS_TO=ventas@disfraceskustom.com

# Mercado Pago — Fase 1: credenciales de PRUEBA (sandbox), NO producción.
# MP → Tus integraciones → tu app → Credenciales de prueba.
# Sin MP_ACCESS_TOKEN, /api/checkout/mercadopago responde 503 y queda WhatsApp.
MP_ACCESS_TOKEN=        # SECRETO, solo servidor. En Fase 1 empieza por "TEST-"
MP_PUBLIC_KEY=          # Público (frontend). En Fase 1 empieza por "TEST-"
# Firma del webhook (Fase 2, opcional pero recomendado). Se copia de MP → Webhooks
# → "Clave secreta". Si está, /api/webhooks/mercadopago valida x-signature.
MP_WEBHOOK_SECRET=

# Bot de WhatsApp (Cloud API de Meta) — server/api/whatsapp. Prefijo NUXT_ para
# que funcionen como override en RUNTIME (Vercel). Sin token/phone_id, el bot
# calcula la respuesta pero no la envia (se registra en el log).
NUXT_WHATSAPP_TOKEN=          # Token de la app de Meta (WhatsApp → API Setup)
NUXT_WHATSAPP_PHONE_ID=       # Phone number ID del numero de prueba/produccion
NUXT_WHATSAPP_VERIFY_TOKEN=   # Cadena que TU inventas; la misma va en Meta → Webhook
# Kill-switch temporal: 'true' fuerza TODOS los menus a texto numerado (no intenta
# interactivo). Util mientras Meta acepta y descarta el interactivo. Vacio/otro = off.
NUXT_WHATSAPP_FORCE_TEXT_MENU=

# Precio tachado (gancho de oferta) — SOLO visual, no toca el precio real cobrado
# ni la validacion server-side. Encendido por defecto; se apaga sin redeploy
# poniendo NUXT_PUBLIC_SHOW_DISCOUNT=false en el entorno de Vercel.
NUXT_PUBLIC_SHOW_DISCOUNT=true
NUXT_PUBLIC_FAKE_DISCOUNT_PCT=20

# Bandeja de atención humana (/admin/chats). Contraseña única (mín. 6 caracteres);
# sin ella la bandeja responde 503. La sesión es una cookie firmada de 7 días.
NUXT_INBOX_PASSWORD=
# Postgres (Neon). En Vercel la inyecta la integración; en local, copia POSTGRES_URL
# del panel. Sin BD el bot vuelve al estado en memoria y la bandeja no lista nada.
POSTGRES_URL=
# Alerta por WhatsApp al celular del encargado cuando un cliente pide atención
# humana (plantilla aprobada en Meta; params: nombre, número/usuario, último mensaje).
# Sin NUXT_ALERT_WHATSAPP_TO no se envía (el correo a ventas@ es el respaldo).
NUXT_ALERT_WHATSAPP_TO=       # ej. 573001234567 (sin +)
NUXT_ALERT_TEMPLATE_NAME=alerta_atencion

# ---- Módulo de inventario (/admin/inventario) ----
# mock (default) = simulación: lee productos reales de Woo con la llave de LECTURA y
# guarda precios/stock en Postgres (inventory_overrides) sin tocar Woo ni el sitio.
# woo = escribe de verdad en WooCommerce con WOO_WRITE_CONSUMER_KEY/SECRET.
# Cambiar a woo SOLO siguiendo docs/inventario-activacion.md.
NUXT_INVENTORY_BACKEND=mock
# Guarda de validación del adaptador woo: true = solo escribe en productos EN BORRADOR.
# Poner false cuando se validen las operaciones masivas.
NUXT_INVENTORY_WOO_ONLY_DRAFTS=true
# ¿El stock del adaptador se aplica al sitio, al bot y al checkout (lógica de agotado)?
#   auto (default) = solo con adaptador woo · on = también con mock (local/preview) · off = nunca
NUXT_INVENTORY_PUBLIC_STOCK=auto
# Umbral de "stock bajo" por talla (alertas y semáforo del panel)
NUXT_INVENTORY_STOCK_BAJO=5

# ---- Medios de la bandeja (tabla media en Neon) ----
# Retención automática (cron diario keepalive) y tope duro total; ver README.
NUXT_MEDIA_RETENTION_DAYS=60
NUXT_MEDIA_MAX_TOTAL_MB=300

# ---- Imágenes de producto (panel + Fase B) ----
# Subida de imágenes desde /admin/inventario: REST API de WordPress con contraseña de aplicación.
# WordPress → Usuarios → tu perfil → Contraseñas de aplicación → "Inventario Kustom (medios)".
NUXT_WP_APP_USER=
NUXT_WP_APP_PASSWORD=
# Guarda propia de imágenes: true = solo borradores. Default false (subir a Woo no afecta la web mientras el origen sea local).
NUXT_IMAGES_ONLY_DRAFTS=false
# Origen de las imágenes en la web: local (default, archivos del repo) | woo (las de WooCommerce,
# con respaldo local permanente). NO cambiar sin la medición de docs/imagenes-woo-medicion.md.
NUXT_PUBLIC_IMAGES_SOURCE=local
